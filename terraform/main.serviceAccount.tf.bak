resource "google_organization_iam_custom_role" "role-svc-create-apis" {
  role_id     = "role_svc_create_apis_${random_id.random.hex}"
  org_id      = var.organization_id
  title       = "role_svc_create_apis_${random_id.random.hex}"
  description = "Role / permissions to assign to service account for creating apis."
  permissions = [
    "compute.projects.get",
    "secretmanager.versions.access",
    "secretmanager.locations.get",
    "secretmanager.locations.list",
    "secretmanager.secrets.get",
    "secretmanager.secrets.getIamPolicy",
    "secretmanager.secrets.list",
    "secretmanager.versions.get",
    "secretmanager.versions.list",
    "cloudbuild.builds.get",
    "cloudbuild.builds.list",
    "cloudbuild.builds.create",
  ]
}

resource "google_service_account" "svc-check-projects" {
  account_id   = "svc-check-projects-${random_id.random.hex}"
  display_name = "Service account for creating apis"
  project      = local.project.id
}
